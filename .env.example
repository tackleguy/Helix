# Helix talks to any OpenAI-compatible chat-completions endpoint.
#
# Default (no key, works on Vercel out of the box):
#   Pollinations -> GPT-OSS 20B reasoning model
#
# Override LLAMA_BASE_URL + LLAMA_MODEL for anything stronger.
# If the upstream is unreachable, /api/chat silently falls back to a
# built-in mock so the UI stays usable.

# --- Default (no change needed) ---
# LLAMA_BASE_URL=https://text.pollinations.ai/openai
# LLAMA_MODEL=openai

# --- Local llama.cpp (Metal/CUDA) ---
# llama-server -m models/qwen2.5-7b-instruct-q4_k_m.gguf --host 127.0.0.1 --port 8080
# LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# LLAMA_MODEL=helix-local

# --- Groq (fastest free tier, signup required) ---
# LLAMA_BASE_URL=https://api.groq.com/openai/v1
# LLAMA_MODEL=llama-3.3-70b-versatile
# LLAMA_API_KEY=gsk_...

# --- OpenRouter (many models incl. :free tier) ---
# LLAMA_BASE_URL=https://openrouter.ai/api/v1
# LLAMA_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLAMA_API_KEY=sk-or-...

# --- DeepSeek (strong + cheap) ---
# LLAMA_BASE_URL=https://api.deepseek.com/v1
# LLAMA_MODEL=deepseek-chat
# LLAMA_API_KEY=sk-...

# --- Ollama ---
# LLAMA_BASE_URL=http://127.0.0.1:11434/v1
# LLAMA_MODEL=qwen2.5:7b

# --- Tuning ---
# LLAMA_TEMPERATURE=0.7
# LLAMA_MAX_TOKENS=800
# LLAMA_CONNECT_TIMEOUT_MS=5000
# HELIX_SYSTEM_PROMPT="You are Helix..."

# --- Local bundle (npm run install:local) ---
# AI_LOCAL_ONLY=true
# AI_PROVIDER=local
# AI_PREFER_LOCAL=true
# Siblings: ../llama-bin, ../llama.cpp/models, ../ComfyUI — see docs/LOCAL_RUN.md

# --- AI provider (no frontend changes when switching) ---
# AI_PROVIDER=auto          # auto | huggingface | openai | local | runpod
# AI_PREFER_LOCAL=true      # when set, try local backends before HF (dev only)

# --- Local-only dev (no HF credits / fully offline) ---
# Uncomment for localhost — chat + images stay local; HF fallback disabled.
# AI_LOCAL_ONLY=true
# AI_PROVIDER=local
# AI_PREFER_LOCAL=true
# Comment out HF_API_KEY while in local-only mode (or leave set; it will be ignored).

# Hugging Face Inference Providers (recommended for cloud / Vercel)
HF_API_KEY=hf_...
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
# HF_HTML_MODEL=Qwen/Qwen2.5-7B-Instruct
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# HF_BASE_URL=https://router.huggingface.co/v1

# Vercel production only:
# NEXT_PUBLIC_HELIX_CLOUD=1
# NEXT_PUBLIC_HELIX_CLOUD_URL=https://helix-five-wheat.vercel.app
# AI_PROVIDER=huggingface
# HELIX_APP_DOWNLOAD_URL=https://github.com/tackleguy/Helix/releases/latest/download/Helix-macOS-arm64.zip

# OpenAI (optional fallback)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# HELIX_SYSTEM_PROMPT="You are Helix..."

# --- Local backends (dev) ---
# OLLAMA_API_KEY=            # Ollama Cloud — uses https://ollama.com instead of localhost
# LLAMA_TEMPERATURE=0.7
# LLAMA_MAX_TOKENS=800

# Local llama.cpp: ../llama-bin/serve.sh on 127.0.0.1:8080
# Models: llama-3b, qwen-7b, qwen-14b, deepseek-r1, study-helix
# Images: ComfyUI on 127.0.0.1:8188

# --- Future: RunPod / vLLM ---
# RUNPOD_BASE_URL=
# RUNPOD_API_KEY=

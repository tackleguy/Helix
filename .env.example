# llama.cpp / OpenAI-compatible chat server. When unreachable, /api/chat
# silently falls back to a built-in mock response so the UI stays alive.
#
# Quickstart:
#   llama-server -m models/qwen2.5-7b-instruct-q4_k_m.gguf \
#     --host 127.0.0.1 --port 8080
#
# Then copy this file to .env.local — no defaults need changing.

LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_MODEL=helix-local
# LLAMA_API_KEY=
LLAMA_TEMPERATURE=0.7
LLAMA_MAX_TOKENS=1024
LLAMA_CONNECT_TIMEOUT_MS=2000

# --- Drop-in alternatives ---
#
# Ollama:
#   LLAMA_BASE_URL=http://127.0.0.1:11434/v1
#   LLAMA_MODEL=qwen2.5:7b
#
# vLLM:
#   LLAMA_BASE_URL=http://your-host:8000
#   LLAMA_MODEL=Qwen/Qwen2.5-7B-Instruct

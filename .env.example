# Helix model registry lives in lib/models.ts. The picker UI shows every
# entry and routes /api/chat to the chosen backend. These env vars are
# how you tune behavior or unlock cloud providers.

# Default model id on first load (must match an entry in lib/models.ts).
# Defaults to "pollinations" (free, no key, works out of the box).
# HELIX_DEFAULT_MODEL=qwen-7b

# Local llama.cpp is served by ../llama-bin/serve.sh on 127.0.0.1:8080.
# To run a local model:
#   /Users/maxr/Documents/Helix/llama-bin/serve.sh qwen-7b
# Models the picker shows under "Local":
#   llama-3b, qwen-7b, qwen-14b, deepseek-r1
# (No env vars needed — the picker probes the local server every 8s.)

# --- Cloud provider keys ---
# Setting any of these makes the corresponding model "Available" in the
# picker. Otherwise it shows as needing-a-key and won't be selectable.

# GROQ_API_KEY=gsk_...        # unlocks "Llama 3.3 70B (Groq)"
# DEEPSEEK_API_KEY=sk-...     # unlocks "DeepSeek V3"

# --- Tuning ---
# LLAMA_TEMPERATURE=0.7
# LLAMA_MAX_TOKENS=800
# LLAMA_CONNECT_TIMEOUT_MS=5000
# HELIX_SYSTEM_PROMPT="You are Helix..."
